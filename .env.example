# 이 파일을 .env.local 로 복사해서 사용하세요. (.env.local 은 git 에 올라가지 않습니다)

# demo  : 브라우저 localStorage 에 데모 데이터로 동작 (Firebase 없이 바로 실행)
# firebase : Firestore / Auth / Functions 사용
VITE_DATA_MODE=demo

# 데모 모드 관리자 비밀번호 (firebase 모드에서는 Firebase Auth 로그인 사용)
VITE_ADMIN_DEMO_PASSCODE=angels2026

# 카카오톡 채널 상담 URL
VITE_KAKAO_CHANNEL_URL=https://pf.kakao.com/

# 고객 관리 URL 의 기준 주소 (메일에 들어가는 링크). 배포 도메인으로 바꾸세요.
VITE_PUBLIC_BASE_URL=http://localhost:5173

# ── Firebase 웹 앱 설정 (Firebase 콘솔 > 프로젝트 설정 > 내 앱 > SDK 설정) ──
# 이 값들은 '공개용' 설정값입니다. 비공개 키(서비스 계정 JSON)와 다릅니다.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_FUNCTIONS_REGION=asia-northeast3
