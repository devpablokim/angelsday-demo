rules_version = '2';

// ─────────────────────────────────────────────────────────────────────────────
// 엔젤스데이 Firestore 보안 규칙
//
// • 고객 관리 URL(/my/{토큰})의 토큰 = bookings 문서 ID (22자 난수, 약 110bit).
//   ID 를 아는 사람만 문서를 `get` 할 수 있고, 목록 조회(`list`)는 관리자만 가능합니다.
//   → 링크 자체가 열쇠(capability URL)이므로 고객에게만 전달하세요.
// • 관리자 = Firebase Auth 커스텀 클레임 { admin: true } (functions/scripts/set-admin.mjs)
// • Cloud Functions(Admin SDK)는 규칙을 우회합니다. 결제·메일 기록·캘린더 동기화는 서버에서만 씁니다.
// ─────────────────────────────────────────────────────────────────────────────
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // ── 예약 ────────────────────────────────────────────────
    match /bookings/{bookingId} {
      allow get: if true;
      allow list: if isAdmin();
      allow delete: if isAdmin();

      allow create: if isAdmin() || validCustomerCreate(bookingId);
      allow update: if isAdmin() || validCustomerUpdate();

      function str(v, max) {
        return v is string && v.size() > 0 && v.size() <= max;
      }

      function validCustomerCreate(id) {
        let d = request.resource.data;
        return id.matches('^[a-z2-9]{22}$')
          && d.id == id
          && d.keys().hasOnly([
            'id', 'accessCode', 'eventType', 'date', 'time', 'hallId', 'location', 'guests', 'customer', 'honorees',
            'inquiryMemo', 'source', 'requirements', 'adjustRequests', 'payments', 'prepTasks',
            'checklist', 'daySchedule', 'photos', 'timeline', 'emails', 'createdAt', 'updatedAt'
          ])
          && d.eventType in ['wedding', 'dol', 'birthday', 'corporate', 'catering']
          && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && d.time is string && d.time.matches('^[0-9]{2}:[0-9]{2}$')
          && (!('hallId' in d) || d.hallId in ['lovely', 'aloha', 'bellita', 'sia', 'whole'])
          && (!('accessCode' in d) || (d.accessCode is string && d.accessCode.matches('^[A-Z2-9]{4}-[A-Z2-9]{4}$')))
          && d.guests is int && d.guests > 0 && d.guests <= 2000
          && d.customer is map
          && str(d.customer.name, 60) && str(d.customer.phone, 30) && str(d.customer.email, 120)
          && d.honorees is map
          && d.source == 'web'
          && d.requirements is map && d.requirements.size() <= 80
          // 서버 전용 데이터는 비어 있어야 합니다.
          && d.payments == [] && d.emails == [] && d.prepTasks == [] && d.photos == []
          && d.adjustRequests == [] && d.checklist == [] && d.daySchedule == []
          && d.timeline is list && d.timeline.size() <= 1;
      }

      // 고객이 바꿀 수 있는 필드만 (견적·결제·준비 리스트·사진·메일 기록 등은 관리자/서버 전용)
      function validCustomerUpdate() {
        let before = resource.data;
        let after = request.resource.data;
        return after.diff(before).affectedKeys().hasOnly([
            'requirements', 'requirementsSubmittedAt', 'guests', 'hallId', 'location',
            'adjustRequests', 'checklist', 'timeline', 'prepStartedAt', 'updatedAt'
          ])
          && !('cancelledAt' in before)
          && after.requirements is map && after.requirements.size() <= 80
          && after.guests is int && after.guests > 0 && after.guests <= 2000
          && (!('hallId' in after) || after.hallId in ['lovely', 'aloha', 'bellita', 'sia', 'whole'])
          && after.checklist is list && after.checklist.size() <= 200
          && appendOnly(before.adjustRequests, after.adjustRequests, 1)
          && newAdjustIsOpen(before.adjustRequests, after.adjustRequests)
          && timelineByCustomer(before.timeline, after.timeline)
          // 준비 시작은 예약금 결제 이후에만 (결제는 서버가 기록)
          && (!('prepStartedAt' in after) || before.payments.size() > 0);
      }

      // 기존 항목은 그대로 두고 최대 max 개까지 뒤에 추가만 허용
      // (규칙 엔진은 빈 범위 슬라이스 b[0:0] 를 오류로 처리하므로 a 가 비어 있으면 비교를 건너뜁니다)
      function appendOnly(a, b, max) {
        return b is list && b.size() >= a.size() && b.size() <= a.size() + max
          && (a.size() == 0 || b[0:a.size()] == a);
      }

      function newAdjustIsOpen(a, b) {
        return b.size() == a.size()
          || (b[b.size() - 1].status == 'open' && !('reply' in b[b.size() - 1]) && str(b[b.size() - 1].message, 1000));
      }

      // 타임라인: 추가만 가능, 고객이 추가한 기록은 actor=customer 이고 내부용(internal) 표시 불가.
      // 고객 동작 1회당 기록 1건이 추가되므로 한 번에 최대 2건까지 허용합니다.
      function customerEntry(e) {
        return e.actor == 'customer' && (!('internal' in e) || e.internal != true) && str(e.message, 2000);
      }
      function timelineByCustomer(a, b) {
        return appendOnly(a, b, 2)
          && (b.size() == a.size() || customerEntry(b[b.size() - 1]))
          && (b.size() <= a.size() + 1 || customerEntry(b[b.size() - 2]));
      }
    }

    // ── 예약 비밀번호 → 예약 ID. 비밀번호를 아는 사람만 문서 ID 로 조회(get)할 수 있고 목록 조회는 불가 ──
    match /codes/{code} {
      allow get: if code.matches('^[A-Z2-9]{8}$');
      allow list: if isAdmin();
      allow create: if code.matches('^[A-Z2-9]{8}$')
        && request.resource.data.keys().hasOnly(['bookingId', 'createdAt'])
        && request.resource.data.bookingId is string
        && exists(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId));
      allow update, delete: if isAdmin();
    }

    // ── 공개 캘린더 (행사명·홀·상태만, 연락처 없음). 예약 미러링은 Functions 가, 수동 일정은 관리자가 씀 ──
    match /calendar/{entryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── 설정: 가격표 · 자동 메일 on/off ──
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── 메일 큐(Trigger Email 확장) · 발송 중복 방지 마커: 서버 전용 ──
    match /mail/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /emailSent/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
