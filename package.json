{
  "name": "angelsday-journey",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "엔젤스데이 고객 여정 & 운영 관리 웹 (문의 → 견적 → 결제 → 준비 → 행사 → 사진)",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "build:preview": "tsc -p tsconfig.json --noEmit && vite build --mode preview",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "deploy": "npm run build && firebase deploy"
  },
  "dependencies": {
    "firebase": "^13.1.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "pretendard": "^1.3.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
