{
  // shared/ 도메인 코드(웹과 공용)를 함께 컴파일합니다.
  // 출력: lib/functions/src/*.js, lib/shared/*.js  (package.json "main" = lib/functions/src/index.js)
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "commonjs",
    "moduleResolution": "node10",
    "rootDir": "..",
    "outDir": "lib",
    "strict": true,
    "noUnusedLocals": true,
    "noImplicitReturns": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "types": ["node"]
  },
  "include": ["src", "../shared"]
}
