{
  "name": "angelsday-functions",
  "private": true,
  "description": "엔젤스데이 Cloud Functions — 예약 메일 자동화 · 챗봇(Claude) · 결제 · 공개 캘린더 동기화",
  "main": "lib/functions/src/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:watch": "tsc -p tsconfig.json --watch",
    "serve": "npm run build && firebase emulators:start --only functions,firestore,auth,storage",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "admin:set": "node scripts/set-admin.mjs",
    "seed": "npm run build && node scripts/seed-firestore.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  }
}
